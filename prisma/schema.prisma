generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------
// NEXTAUTH REQUIRED TABLES
// -------------------------------------
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------
// HUNGRY CHICKEN CUSTOM TABLES
// -------------------------------------

// One single storefront, one owner. `role: "admin"` marks the owner account
// that can see the Kitchen Portal. Everyone else is `"user"`.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // bcrypt hash, only set for email/password accounts

  phone         String?
  phoneVerified DateTime?

  role          String    @default("user")

  // --- OTP / account-activation state ---
  emailOtpCode      String?
  emailOtpExpires   DateTime?
  phoneOtpCode      String?
  phoneOtpExpires   DateTime?
  otpVerifiedAt     DateTime?   // set once BOTH email + phone OTP are confirmed
  pendingActivation Boolean     @default(true) // flips to false once the emailed verification link is clicked

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  wishlist      WishlistItem[]
  addresses     Address[]

  createdAt     DateTime  @default(now())
}

// Saved delivery/pickup addresses per customer
model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home")
  line1     String
  line2     String?
  city      String
  postcode  String
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The single shared menu, tagged by section so the two storefronts
// (Grill / Sweets) can filter the same table.
model MenuItem {
  id          String   @id @default(cuid())
  section     String   // "grill" | "sweets"
  category    String
  name        String
  description String   @default("")
  price       Float
  image       String   @default("")
  available   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  userId     String
  menuItemId String
  name       String
  price      Float
  image      String
  brand      String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  status        String      @default("pending") // pending -> preparing -> ready -> completed | cancelled
  fulfillment   String      @default("pickup")  // "pickup" | "delivery"
  subtotal      Float       @default(0)
  tax           Float       @default(0)
  totalAmount   Float
  instructions  String?

  customerName  String?
  customerPhone String?
  address       String?     // delivery address text (empty for pickup)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String?
  name       String
  brand      String
  quantity   Int
  price      Float
  notes      String  @default("")

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
